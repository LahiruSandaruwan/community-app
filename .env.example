# Environment Configuration Example
# Copy this file to .env.development, .env.staging, .env.production
# DO NOT commit actual .env files with sensitive data

# Environment (development, staging, production)
ENVIRONMENT=development

# PocketBase Server URL
# Development: http://127.0.0.1:8090
# Production: https://your-pocketbase-server.com
POCKETBASE_URL=http://127.0.0.1:8090

# Firebase Configuration (optional, if using Firebase services)
FIREBASE_PROJECT_ID=educonnect-dev
